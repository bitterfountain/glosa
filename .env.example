# Configuración del bot de Telegram de Glosa (informes de visitas).
# En el servidor este fichero vive FUERA del webroot, como glosa.env en la carpeta GLOSA_DATA_DIR (600).
# En local, cópialo a .env (ignorado por git). Nunca subas el token al repositorio.

# Token del bot (@BotFather → /newbot). Bot: @GlosaEBookReaderBot
TELEGRAM_BOT_TOKEN=

# Secreto que Telegram manda en cada llamada al webhook (cabecera X-Telegram-Bot-Api-Secret-Token).
# Genera uno: openssl rand -hex 24. Se registra con setWebhook (ver telegram-webhook.php).
TELEGRAM_WEBHOOK_SECRET=

# IDs de chat que pueden pedir informes, separados por comas. Escribe /id al bot para saber el tuyo.
TELEGRAM_ALLOWED_IDS=
